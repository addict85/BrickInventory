{
  // Typprüfung der Tests (CommonJS, checkJs), vorerst ohne strict: Die Zahl der
  // Meldungen ist eine Ratsche (scripts/check-test-typen.js), sie darf nur sinken.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "types": ["node"],
    "strict": false
  },
  "include": ["test/**/*.js"],
  "exclude": ["test/fixtures"]
}
