// Im Rumpf von k.transaktion(async t => …) ist k noch sichtbar; eine Abfrage darüber
// liefe neben der Transaktion (zur Laufzeit: UngebundeneAbfrage). Der Rumpf fragt über t.
language js

`$z.$m($rumpf, $...)` where {
  $m <: or { `transaktion`, `transaction` },
  $rumpf <: or {
    `async ($p) => $b`,
    `($p) => $b`,
    `async $p => $b`,
    `$p => $b`,
    `async function ($p) { $b }`,
    `function ($p) { $b }`
  },
  $b <: contains JsIdentifierExpression() as $treffer where {
    $treffer <: or { `k`, `sk`, `kx`, $z },
    not $treffer <: $p
  },
  register_diagnostic(
    span=$treffer,
    message="Äusserer Zugang im Rumpf einer Transaktion: über den Kontext der Transaktion (t) fragen.",
    severity="error"
  )
}
