# Caddy vor der App: HTTPS mit eigener CA für BRICK_HOST aus .env.
# Siehe README.md (HTTPS) und UPGRADE.md, Abschnitt 14.
{
	# Keine Verwaltungsschnittstelle: Die Konfiguration ändert sich nur mit
	# dieser Datei und einem Neustart.
	admin off
	# Die Umleitung auf https steht unten selbst, weil /ca.crt ausgenommen ist.
	auto_https disable_redirects
	# Caddy soll die CA nicht in den Container-Truststore eintragen.
	skip_install_trust
	# Ein Gerät, das per IP-Adresse kommt, schickt keinen Namen (SNI).
	default_sni {$BRICK_HOST}
	# Mit eigener CA (./caddy/ca, scripts/ca-einrichten.sh) setzt das Startskript
	# in compose.yaml Wurzel und Zwischenstelle hier ein; sonst legt Caddy seine an.
	pki {
		ca local {
			name "BrickInventory"
			{$BRICK_CA_EIGEN}
		}
	}
}

https://{$BRICK_HOST} {
	# Die App pinnt die Wurzel (QR-Code, `fp`), sie muss in der Kette stehen.
	# Caddys eigene CA: Die Wurzel signiert selbst (ihre Zwischenstelle lebt 7
	# Tage und liegt im selben Volume). Eigene CA: Die Zwischenstelle signiert,
	# ihre Kettendatei trägt die Wurzel mit (BRICK_CA_SIGNIEREN = „ca local“).
	tls {
		issuer internal {
			{$BRICK_CA_SIGNIEREN:sign_with_root}
		}
	}
	reverse_proxy app:3000 {
		# Eine eigene Kennung je Anfrage; die des Clients wird ersetzt.
		header_up X-Request-Id {http.request.uuid}
	}
	header -Server
}

http:// {
	# Nur das Wurzelzertifikat gibt es im Klartext: Ein Gerät braucht es, bevor
	# es HTTPS vertraut. Abgleichen am Fingerabdruck (Einstellungen der App).
	handle /ca.crt {
		reverse_proxy app:3000
	}
	handle {
		redir {$BRICK_BASE_URL}{uri} 308
	}
}
