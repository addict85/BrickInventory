# Caddy vor der App: HTTPS für BRICK_HOST aus .env.
# Siehe README.md (HTTPS) und UPGRADE.md#wurzelzertifikat, #ca-einrichten.
{
	# Keine Verwaltungsschnittstelle: Die Konfiguration ändert sich nur mit
	# dieser Datei und einem Neustart.
	admin off
	# Die Umleitung auf https steht unten selbst, weil /ca.crt ausgenommen ist.
	auto_https disable_redirects
	# Caddy soll die CA nicht in den Container-Truststore eintragen.
	skip_install_trust
	# Ein Kopf, der nach 10 s nicht da ist, kommt nicht mehr (Vorgabe: eine
	# Minute). Für den Rumpf keine harte Frist: Sie bräche lange Uploads ab;
	# die Anmeldewege puffern ihn stattdessen (unten).
	servers {
		timeouts {
			read_header 10s
		}
		# Ein Proxy vor Caddy (Nginx Proxy Manager o. ä.): Nur seiner Adresse
		# glaubt Caddy X-Forwarded-For, von rechts gelesen (strict), damit ein
		# Client keinen eigenen Eintrag voranstellen kann. `keiner` (Startskript): niemandem.
		trusted_proxies static {$VORGELAGERTER_PROXY}
		trusted_proxies_strict
	}
	# Ein Gerät, das per IP-Adresse kommt, schickt keinen Namen (SNI).
	default_sni {$BRICK_HOST}
	# Mit eigener CA (./caddy/ca, scripts/ca-einrichten.sh) setzt das Startskript
	# in compose.yaml Wurzel und Zwischenstelle hier ein.
	pki {
		ca local {
			name "BrickInventory"
			{$BRICK_CA_EIGEN}
		}
	}
}

# Anmeldewege, die ohne Sitzung ein Passwort (bcrypt) oder eine Signatur
# prüfen. Die Zahl gleichzeitiger Prüfungen begrenzt der Server selbst (Schranke
# mit Vorrang bekannter Anmeldungen, 503 bei Überlast); eine Verbindungsgrenze
# hier stellte die Flut davor in eine Schlange ohne Ende, Frist und Vorrang.
# Caddy hält nur überlange und langsame Rümpfe fern.
(anmeldung) {
	@anmeldung {
		method POST
		path /api/v1/auth/login /api/v1/auth/register /api/v1/auth/forgot-password /api/v1/auth/reset-password /api/v1/auth/bestaetigung-erneut /api/v1/auth/qr-login /api/v1/auth/qr-login/abholen /api/v1/auth/token-rotieren /api/v1/auth/passkey/anmelden /api/v1/auth/passkey/anmelden/optionen
	}
	handle @anmeldung {
		request_body {
			max_size 16KB
		}
		reverse_proxy app:3000 {
			header_up X-Request-Id {http.request.uuid}
			header_up X-Forwarded-For {client_ip}
			# Erst den ganzen Rumpf lesen, dann zur App: Ein langsamer Rumpf
			# belegt dort keine Verbindung. Grösser als max_size, damit ein
			# überlanger Rumpf hier mit 413 endet, statt ab der Puffergrenze
			# doch zur App zu strömen.
			request_buffers 32KB
		}
	}
}

https://{$BRICK_HOST} {
	# Der Aussteller kommt aus dem Startskript in compose.yaml (eigene CA,
	# acme oder ausdrücklich Caddys CA). Fehlt er, ist diese Datei ungültig:
	# kein stiller Rückfall auf eine CA ohne Namensbeschränkung.
	tls {
		# Beim Erneuern derselbe Schlüssel: Die Android-App pinnt unter einer
		# öffentlichen CA den Schlüssel des Blatts und fragt bei einem neuen nach.
		# So bleibt ein Wechsel selten und auffällig (UPGRADE.md#schluessel-behalten).
		reuse_private_keys
		issuer {$BRICK_TLS_AUSSTELLER} {
			{$BRICK_TLS_OPTIONEN}
		}
	}
	import anmeldung
	handle {
		reverse_proxy app:3000 {
			# Eine eigene Kennung je Anfrage; die des Clients wird ersetzt.
			header_up X-Request-Id {http.request.uuid}
			# Genau eine Adresse: die des Clients nach trusted_proxies oben. Die
			# App vertraut nur Caddy und liest damit diese, nicht die des Proxys davor.
			header_up X-Forwarded-For {client_ip}
		}
	}
	header -Server
}

http:// {
	# Nur das Wurzelzertifikat gibt es im Klartext: Ein Gerät braucht es, bevor
	# es HTTPS vertraut. Echt ist es nur, wenn der Fingerabdruck auf dem Gerät
	# dem im Protokoll von Caddy gleicht (UPGRADE.md#wurzelzertifikat).
	# Nur GET und HEAD auf genau diese Datei; alles andere geht auf HTTPS.
	@wurzel {
		method GET HEAD
		path /ca.crt
	}
	handle @wurzel {
		reverse_proxy app:3000
	}
	handle {
		redir {$BRICK_BASE_URL}{uri} 308
	}
}
