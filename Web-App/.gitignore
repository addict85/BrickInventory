# Ohne diese Datei erfasste `git add -A` node_modules, dist und data (216 MB).

# Abhängigkeiten und Bauergebnisse. Ohne Schrägstrich, damit auch ein
# Symlink namens node_modules (geteilter Arbeitsbaum) ignoriert wird.
node_modules
dist

# Das Frontend-Bündel ist ein Erzeugnis aus public/js/ (scripts/build-frontend.js,
# gebaut von npm run build, Dockerfile, CI und test-lauf.js). Auch Zwischendatei
# (.tmp) und Sourcemap (.map) gehören nicht nach git.
public/js/app.bundle.js
public/js/app.bundle.js.*

# Laufzeitdaten: Bilder, Vorschaubilder, Uploads, Zwischenstände
data/
schluessel/
# Docker-Secrets (scripts/geheimnisse-einrichten.sh) und Empfänger der Sicherung
geheimnisse/
backup-empfaenger.txt
# Standardziel von scripts/backup.sh: Dumps samt Schlüsselkopie
backups/
pgdata/
pgdata18/
# Caddy: CA mit privatem Schlüssel und Zertifikate
caddy/

# Protokolle und lokale Umgebung
*.log
.env
.env.*
# ... aber eine Beispieldatei gehört ins Repository.
!.env.example

# Betriebssystem und Editor
.DS_Store
Thumbs.db
*.swp

# Abdeckungsbericht (npm run abdeckung)
coverage
