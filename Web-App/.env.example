# BrickInventory Manager — Umgebungsvariablen
#
# Als .env neben compose.yaml ablegen; Docker Compose liest sie automatisch.
# Der Server prüft alle Werte beim Start (src/infra/konfig.ts) und bricht bei einem
# ungültigen mit einer Meldung je Variable ab. Leer oder auskommentiert heisst:
# die Vorgabe in Klammern gilt.

# ── Geheimnisse: NICHT hier ──────────────────────────────────────────────────
# Mit Docker stehen Sitzungsgeheimnis und Datenbankpasswörter als Dateien in
# ./geheimnisse/ (Docker-Secrets, compose.yaml); `sh scripts/geheimnisse-einrichten.sh`
# legt sie an und übernimmt dabei SESSION_SECRET, DB_PASSWORD und DB_APP_PASSWORD
# aus einer alten .env. Danach diese Zeilen hier löschen.
# Ohne Docker (npm start) gelten weiter die Variablen:
# Signiert die Sitzungs-Cookies. Mindestens 32 Zeichen (openssl rand -base64 48).
# SESSION_SECRET=

# ── Image ────────────────────────────────────────────────────────────────────
# `sh scripts/image-pruefen.sh` prüft die Signatur des Tags BRICK_TAG und
# trägt App- und Caddy-Image als Digest ein (BRICK_IMAGE=addict85/brickinventory@sha256:…,
# CADDY_IMAGE=addict85/brickinventory-caddy@sha256:…). Ohne beide startet compose nicht.
# Selbst gebaut: BRICK_IMAGE=brickinventory:lokal, CADDY_IMAGE=brickinventory-caddy:lokal.
# Tag, den das Skript prüft, etwa ein fester Stand wie sha-1a2b3c4. (latest)
# BRICK_TAG=latest

# ── Netz und HTTPS ───────────────────────────────────────────────────────────
# Name oder IP-Adresse, unter der Geräte den Server erreichen. Pflicht.
# Für Passkeys ein Name (nas.example.lan), keine IP-Adresse.
BRICK_HOST=
# Woher Caddy das Zertifikat für BRICK_HOST nimmt (UPGRADE.md, Abschnitt 33):
#   intern  eigene, auf BRICK_HOST beschränkte CA aus ./caddy/ca
#           (sudo sh scripts/ca-einrichten.sh) — ohne sie startet Caddy nicht
#   acme    öffentlicher Name mit Let's Encrypt (Ports 80/443 aus dem Internet erreichbar)
# BRICK_TLS=intern
# Kontaktadresse für Let's Encrypt (nur bei acme). (leer)
# ACME_EMAIL=betrieb@example.org
# Nur ausdrücklich: Caddys eigene CA OHNE Namensbeschränkung. Wer ihre Wurzel
# installiert, vertraut ihr für JEDE Adresse. (nein)
# CA_OHNE_NAMENSBESCHRAENKUNG=ja
# Adresse, unter der der Server von aussen erreichbar ist (Mails, QR-Code,
# Passkeys). (https://BRICK_HOST)
# APP_BASE_URL=https://lego.example.org
# Ohne APP_BASE_URL bricht der Start im Betrieb ab (compose setzt sie immer).
# Nur wer bewusst ohne Host-Filter laufen will, setzt das (UPGRADE.md). (0)
# APP_BASE_URL_FEHLT_OK=0
# Schnittstelle für die Ports 443 und 80 von Caddy. (0.0.0.0)
# HTTPS_BIND=0.0.0.0
# Wem X-Forwarded-For/-Proto geglaubt wird: feste Adressen oder kleine Netze.
# compose.yaml setzt die Adresse von Caddy. (ohne compose: Loopback)
# TRUST_PROXY=172.28.73.10
# Steht ein Proxy VOR Caddy (z. B. Nginx Proxy Manager)? Pflicht, ohne startet
# Caddy nicht:
#   keiner          Caddy ist direkt erreichbar, glaubt keinem X-Forwarded-For
#   172.28.73.20    Adresse(n) oder Netze (CIDR) des Proxys, wie Caddy sie sieht,
#                   durch Leerzeichen getrennt
# Siehe README.md, „Proxy vor Caddy“.
VORGELAGERTER_PROXY=
# Nur für die bewusste Klartext-Ausnahme (Port 3000 in compose.yaml):
# APP_BIND=127.0.0.1
# Port im Container. (3000)
# PORT=3000
# Cookie nur über HTTPS: 1 oder 0. (in Produktion 1)
# COOKIE_SECURE=1
# max-age der HSTS-Kopfzeile in Sekunden, 0 schaltet sie ab. (31536000)
# HSTS_MAX_AGE=31536000
# Wurzelzertifikat der internen CA (PEM) für /ca.crt und den Fingerabdruck im
# QR-Code; compose.yaml setzt es, der Entrypoint kopiert es aus Caddys Volume.
# CA_ZERTIFIKAT=/tmp/ca/root.crt
# SHA-256-Fingerabdrücke der Signaturzertifikate der Android-App, mit Komma
# getrennt (keytool -list -v oder Play Console → App-Signatur). Erst damit nimmt
# der Server Passkey-Anmeldungen der App an und liefert
# /.well-known/assetlinks.json aus. Google holt das Dokument von der Domain aus
# APP_BASE_URL — sie muss öffentlich erreichbar sein, mit einem öffentlich
# vertrauten Zertifikat und an der Wurzel (kein Pfad-Präfix). (leer: keine App)
# PASSKEY_ANDROID_ZERTIFIKATE=AB:CD:…:EF
# Paketname der App im Dokument. (ch.brickinventoryapp)
# PASSKEY_ANDROID_PAKET=ch.brickinventoryapp
# Beide gelten auch für den Geräteschlüssel des Schrittschutzes: Seine Android Key
# Attestation muss Paketname und einen dieser Fingerabdrücke nennen. Ohne
# Fingerabdruck hinterlegt keine App einen Schlüssel (UPGRADE.md).
# Bis zu diesem Tag gelten Geräteschlüssel, die ohne Attestation hinterlegt
# wurden; danach meldet man sich in der App neu an. (2027-02-01)
# GERAETESCHLUESSEL_ALT_BIS=2027-02-01
# Nur NODE_ENV=development/test: eigene Attestierungswurzeln (PEM) statt der von
# Google, für Tests mit selbst erzeugten Ketten. Im Betrieb ein Startfehler.
# ATTESTATION_WURZELN=
# Googles Widerrufsliste lädt der Job-Prozess alle sechs Stunden. Ist die letzte
# geladene älter als so viele Tage (oder fehlt sie), nimmt der Server keinen neuen
# Geräteschlüssel an. (7)
# ATTESTATION_WIDERRUF_TAGE=7
# Mindest-Sicherheitspatch des Geräts als JJJJMM; leer nimmt jeden Stand.
# ATTESTATION_PATCH_MINDESTENS=

# ── Sitzungen und Tokens ─────────────────────────────────────────────────────
# Minuten ohne Betrieb, nach denen eine Sitzung endet. (240)
# SESSION_IDLE_MINUTES=240
# Höchstdauer einer Sitzung ab der Anmeldung in Stunden. (168)
# SESSION_MAX_HOURS=168
# Tage ohne Nutzung, nach denen ein Gerätezugang verfällt, mindestens 1. (90)
# „Unbegrenzt“ gibt es nur je Gerät beim QR-Code, über HTTPS und mit Rotation.
# TOKEN_IDLE_DAYS=90

# ── Prozesse und Datenbank ───────────────────────────────────────────────────
# Was der Prozess tut: web (Anfragen), jobs (Hintergrundarbeit) oder beides.
# compose.yaml startet zwei Dienste, app mit web und jobs mit jobs. (beides)
# ROLLE=beides
# Statt der einzelnen PG*-Werte eine vollständige Adresse.
# DATABASE_URL=postgres://brickinventory:passwort@postgres:5432/brickinventory
# PGHOST=postgres
# PGPORT=5432
# PGUSER=brickinventory_app
# Ohne Docker hier; mit Docker kommt es aus ./geheimnisse/db_app_password.
# PGPASSWORD=
# PGDATABASE=brickinventory
# Systemrolle (BYPASSRLS) für Arbeit über Kontogrenzen: Aufträge, Verwaltung,
# Anmeldung. Ohne Angabe läuft sie über PGUSER — dann muss dieser die Tabellen
# besitzen, sonst verweigert der Start. Mit Docker aus ./geheimnisse/db_system_password.
# PGSYSTEM_USER=brickinventory_system
# PGSYSTEM_PASSWORD=
# TLS zur Datenbank. Auf demselben Rechner (Compose-Dienst postgres) nicht
# nötig; eine entfernte Datenbank mit verify-full, sonst warnt der Start.
# PGSSLMODE=verify-full
# Verbindungen je Prozess; ohne Angabe min(15, 80 / Prozesse).
# PG_POOL_MAX=15
# Immer offene Verbindungen je Prozess. (2)
# PG_POOL_MIN=2
# Leerlauf, nach dem eine Verbindung schliesst, in ms. (30000)
# PG_IDLE_MS=30000
# Wartezeit auf eine Verbindung in ms. (30000)
# PG_CONN_MS=30000
# Höchste Laufzeit einer Abfrage in ms. (30000)
# PG_STMT_MS=30000

# ── Verwaltung und Daten ─────────────────────────────────────────────────────
# Passwort des ersten Verwalters beim allerersten Start; sonst zufällig.
# ADMIN_PASSWORD=

# ── Geheimnisse aus Dateien (Docker-Secrets) ─────────────────────────────────
# Statt des Werts der Pfad einer Datei, die ihn enthält (z. B. /run/secrets/…):
# Umgebungsvariablen zeigt `docker inspect` jedem, der den Docker-Dienst
# erreicht. Nur eines von X und X_FILE setzen. Beispiel in UPGRADE.md, Runde 7.
# SESSION_SECRET_FILE=/run/secrets/session_secret
# PGPASSWORD_FILE=/run/secrets/db_app_password
# PGSYSTEM_PASSWORD_FILE=/run/secrets/db_system_password
# DATABASE_URL_FILE=
# ADMIN_PASSWORD_FILE=
# Schlüssel für gespeicherte Geheimnisse, 32 Byte base64 (openssl rand -base64 32).
# Geht DATA_KEY_FILE vor.
# DATA_KEY=
# Datei mit dem Schlüssel, ausserhalb von data/ (UPGRADE.md, Abschnitt 21).
# Fehlt sie, legt der erste Start sie an.
# DATA_KEY_FILE=/app/schluessel/datenschluessel
# Nur während eines Schlüsselwechsels: der vorige Schlüssel. Der Start schreibt
# alles, was nur er öffnet, mit dem neuen neu (scripts/datenschluessel-wechseln.sh,
# UPGRADE.md, Abschnitt 43). Eine fehlende Datei heisst: kein Wechsel.
# DATA_KEY_ALT=
# DATA_KEY_ALT_FILE=/app/schluessel/datenschluessel.alt
# Zeitzone, in der eine Erfassung ihren Tag bekommt. (TZ, sonst die des Systems)
# ERFASSUNG_ZEITZONE=Europe/Zurich
# Zeitzone des Prozesses; Rückfall für ERFASSUNG_ZEITZONE.
# TZ=Europe/Zurich
# Tage, die der Preisverlauf aufbewahrt wird; 0 = unbegrenzt. (1095)
# PRICE_HISTORY_KEEP_DAYS=1095
# Platz für eigene Anleitungen je Konto in MB. (2048)
# UPLOAD_KONTINGENT_MB=2048
# Links in Mails ohne SMTP vollständig und Empfänger unmaskiert ins Protokoll schreiben (1), sonst ohne Token und maskiert.
# Nur zur Entwicklung: Mit NODE_ENV=production startet der Server damit nicht.
# MAIL_KONSOLE_MIT_TOKEN=0
# Eigener User-Agent für den Bildabruf (sonst der des Bild-Proxys, ein Browser).
# IMG_USER_AGENT=
# Obergrenze des Bild-Proxy-Caches (data/img_proxy_cache) in MB; darüber
# fallen die am längsten unbenutzten Bilder zuerst weg. (2048)
# BILD_CACHE_MAX_MB=2048
# CDN-Abrufe des Bild-Proxys je Konto und Minute; Cache-Treffer zählen nicht. (240)
# BILD_ABRUFE_JE_MINUTE=240

# Gleichzeitige Passwortprüfungen (bcrypt-Worker, je gut 12 MB), 1–64.
# Ohne Angabe: Kerne bzw. cgroup-CPU-Kontingent, höchstens 4, mindestens 2.
# BCRYPT_ARBEITER=4

# ── Hintergrundarbeit ────────────────────────────────────────────────────────
# Gleichzeitige Aufträge im Job-Prozess; lange Läufe (Bildbedarf, Preise)
# belegen je einen Platz. (4)
# AUFTRAG_PARALLEL=4
# Frist eines laufenden Auftrags in Sekunden, danach wird er neu vergeben. (300)
# AUFTRAG_FRIST_SEK=300
# Höchstdauer je Zeile eines CSV-Imports in ms. (120000)
# CSV_ZEILE_FRIST_MS=120000

# ── Nur für Entwicklung und Bau ──────────────────────────────────────────────
# production im Betrieb (Image und `npm start` setzen es). Ohne NODE_ENV gelten
# die Regeln des Betriebs für SESSION_SECRET; das Entwicklungsgeheimnis gibt es
# nur bei ausdrücklichem development oder test (`npm run dev` setzt es).
# NODE_ENV=production
# Start als Datenbank-Superuser in Produktion trotzdem erlauben (UPGRADE.md,
# Abschnitt 34). Besser: eigene Rolle (Abschnitt 29). (0)
# DB_SUPERUSER_ERLAUBT=0
# Jede API-Antwort gegen ihren Vertrag prüfen (src/vertrag/); die Tests
# setzen das selbst. Im Betrieb aus: Es kostet je Antwort einen Durchlauf. (0)
# VERTRAG_PRUEFEN=0
# Wurzel des Programms, falls nicht neben package.json. (automatisch)
# APP_ROOT=
# Version, die der Server anzeigt; der Docker-Bau setzt sie aus Git.
# APP_VERSION=
