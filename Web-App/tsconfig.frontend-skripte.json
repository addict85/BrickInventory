{
  // Die zwei klassischen Skripte der Oberfläche: theme-boot.js läuft vor
  // dem Bündel im <head>, logviewer.js im Protokollfenster. Ihre Funktionen
  // sind absichtlich global (window[name]), deshalb ohne moduleDetection "force".
  "extends": "./tsconfig.frontend.json",
  "compilerOptions": {
    "moduleDetection": "auto",
    "noUnusedLocals": false
  },
  "include": ["public/js/theme-boot.js", "public/js/logviewer.js", "frontend-typen/*.d.ts"],
  "exclude": []
}
