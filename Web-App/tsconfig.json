{
  // tsc prüft nur (noEmit); übersetzt wird mit esbuild (Docker-Bau, npm run
  // build) bzw. tsx (npm run dev). Jeder Schalter unten wurde erst
  // eingeschaltet, als er 0 Meldungen ergab; ein dauerhaft roter Schalter
  // wird übersehen. Stand messen: npx tsc --noEmit [--<schalter>]
  "compilerOptions": {
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "allowImportingTsExtensions": false,
    // scripts/ und test/ sind JavaScript und werden mitgeprüft; dist/ ist
    // Erzeugnis und liegt in exclude.
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "strict": false,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "strictBindCallApply": true,
    "alwaysStrict": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitAny": true,
    // In JavaScript darf alles geworfen werden; gelesen wird über
    // fehlertext()/fehlerCode() (src/infra/httpError.ts), nicht über e.message.
    "useUnknownInCatchVariables": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
    // strictFunctionTypes bleibt aus: Handler, die AuthedRequest verlangen,
    // wären kontravariant nicht mehr an Express' Request zuweisbar, obwohl die
    // Middleware davor das Feld setzt. Alle Meldungen sind dieser eine Fall.
  },
  "include": [
    "server.ts",
    "db/**/*", "src/**/*", "routes/**/*", "jobs/**/*", "scripts/**/*",
    "types/**/*"
  ],
  "exclude": ["node_modules", "public", "data", "dist"]
}
