{
  // Type check of the UI (ES modules under public/js and i18n.js) without
  // emitting: esbuild bundles, tsc only checks. moduleDetection "force", since
  // otherwise the names of the classic scripts count as globals and a missing
  // import goes unnoticed. The two classic scripts are checked by
  // tsconfig.frontend-scripts.json; both run via scripts/check-frontend-types.js.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "lib": ["es2022", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["public/js/*.js", "public/i18n.js", "frontend-types/*.d.ts"],
  "exclude": ["public/js/app.bundle.js", "public/js/theme-boot.js", "public/js/logviewer.js"]
}
