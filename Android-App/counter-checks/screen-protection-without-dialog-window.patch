Gegenprobe: Sichtschutz setzt FLAG_SECURE nur auf das Fenster der Activity, nicht auf das Dialogfenster
Modul: core-ui
Test: ch.brickinventoryapp.ui.components.DialogPrivacyScreenTest
Rot: a revealed password in the dialog is protected immediately and free again afterwards

diff --git a/Android-App/core-ui/src/main/java/ch/brickinventoryapp/ui/components/PrivacyShield.kt b/Android-App/core-ui/src/main/java/ch/brickinventoryapp/ui/components/PrivacyShield.kt
--- a/Android-App/core-ui/src/main/java/ch/brickinventoryapp/ui/components/PrivacyShield.kt
+++ b/Android-App/core-ui/src/main/java/ch/brickinventoryapp/ui/components/PrivacyShield.kt
@@ -28,7 +28,7 @@
     DisposableEffect(view, activity) {
         // A dialog has its own window and only takes over FLAG_SECURE from the window below it
         // on its next rebuild. So both apply immediately, and both are counted.
-        val window = listOfNotNull(activity?.window, (view.parent as? DialogWindowProvider)?.window).distinct()
+        val window = listOfNotNull(activity?.window)
         window.forEach(::secure)
         onDispose { window.forEach(::giveFree) }
     }
