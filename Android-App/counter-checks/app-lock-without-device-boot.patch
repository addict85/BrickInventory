Gegenprobe: Ein Neustart des Geräts sperrt nur noch, wenn die neue Uhr unter dem gemerkten Zeitpunkt steht
Modul: core-ui
Test: ch.brickinventoryapp.ui.AppLockTest
Rot: locked after a reboot, even if the clock is already further

diff --git a/Android-App/core-ui/src/main/java/ch/brickinventoryapp/ui/components/AppLock.kt b/Android-App/core-ui/src/main/java/ch/brickinventoryapp/ui/components/AppLock.kt
--- a/Android-App/core-ui/src/main/java/ch/brickinventoryapp/ui/components/AppLock.kt
+++ b/Android-App/core-ui/src/main/java/ch/brickinventoryapp/ui/components/AppLock.kt
@@ -53,7 +53,7 @@
         val now = clock()
         // After a device restart the clock starts at zero: whether the deadline expired is open.
         // An unreadable counter counts as a different start; without a remembered one (older store), only the clock counts.
-        val restarted = start != null && devicesStart() != start
+        val restarted = false
         if (deadline > 0 && (restarted || now < since || now - since >= deadline)) set(true)
     }
 
