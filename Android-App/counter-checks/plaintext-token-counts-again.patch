Gegenprobe: Der Speicherspiegel nimmt ein Klartext-Token älterer Fassungen wieder als Anmeldung
Modul: core-data
Test: ch.brickinventoryapp.data.TokenVaultTest
Rot: a plaintext token of older versions never counts and is removed at start

diff --git a/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/TokenStore.kt b/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/TokenStore.kt
--- a/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/TokenStore.kt
+++ b/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/TokenStore.kt
@@ -280,7 +280,7 @@
         // null = the "" readToken reports for a still-locked keystore: "not yet", not "signed out".
         // At cold start it is the sign-in screen; over the placeholder or a token it would send every
         // request while locked without one. Missing or gone ciphertext still clears the mirror.
-        mirror<String?, String?>({ it[AUTH_TOKEN_ENC] }, _authTokenState,
+        mirror<String?, String?>({ it[AUTH_TOKEN_ENC] ?: it[AUTH_TOKEN]?.let(vault::encrypt) }, _authTokenState,
             set = { _authTokenState.value = it ?: _authTokenState.value.takeUnless { v -> v.isNullOrEmpty() } ?: "" },
         ) { secret, report ->
             if (secret == null) return@mirror report("")
