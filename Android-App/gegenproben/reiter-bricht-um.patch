Gegenprobe: Beschriftung der Reiter wieder als Text ohne Zeilengrenze
Modul: app
Test: ch.brickinventoryapp.FeinschliffRegelnTest
Rot: Reiterleiste bricht

diff --git a/Android-App/app/src/main/java/ch/brickinventoryapp/MainScaffold.kt b/Android-App/app/src/main/java/ch/brickinventoryapp/MainScaffold.kt
index 2c7f40f..179d391 100644
--- a/Android-App/app/src/main/java/ch/brickinventoryapp/MainScaffold.kt
+++ b/Android-App/app/src/main/java/ch/brickinventoryapp/MainScaffold.kt
@@ -274,18 +274,7 @@ private fun ReiterBeschriftung(text: String, groesse: MutableState<TextUnit>, be
     val stil = MaterialTheme.typography.labelSmall
     val boden = stil.fontSize / LocalDensity.current.fontScale.coerceAtLeast(1f)
     val aktuell = if (groesse.value.isSpecified) groesse.value else stil.fontSize
-    Text(
-        // Mindestabstand zum Rand des Ziels: Bei 200 % stand „Sammlung“ 1 dp vor der Kante.
-        text, Modifier.padding(horizontal = ch.brickinventoryapp.ui.theme.Abstaende.winzig),
-        style = stil.copy(fontSize = aktuell), maxLines = 1, softWrap = false,
-        overflow = TextOverflow.Clip,
-        onTextLayout = { l ->
-            if (l.hasVisualOverflow) {
-                if (aktuell.value - REITER_SCHRIFT_SCHRITT >= boden.value) groesse.value = (aktuell.value - REITER_SCHRIFT_SCHRITT).sp
-                else beschriftet.value = false
-            }
-        },
-    )
+    Text(text, style = stil.copy(fontSize = aktuell), onTextLayout = { if (beschriftet.value && boden.value < 0f) groesse.value = aktuell })
 }
 
 /** Ohne Beschriftung trägt das Symbol den Namen des Ziels. */
