Gegenprobe: Sichtschutz setzt FLAG_SECURE nur auf das Fenster der Activity, nicht auf das Dialogfenster
Modul: core-ui
Test: ch.brickinventoryapp.ui.components.DialogPrivacyScreenTest
Rot: ein aufgedecktes Passwort im Dialog

diff --git a/Android-App/core-ui/src/main/java/ch/brickinventoryapp/ui/components/Sichtschutz.kt b/Android-App/core-ui/src/main/java/ch/brickinventoryapp/ui/components/Sichtschutz.kt
--- a/Android-App/core-ui/src/main/java/ch/brickinventoryapp/ui/components/Sichtschutz.kt
+++ b/Android-App/core-ui/src/main/java/ch/brickinventoryapp/ui/components/Sichtschutz.kt
@@ -25,7 +25,7 @@ fun Sichtschutz(coverage: Boolean = true) {
     DisposableEffect(view, activity) {
         // Ein Dialog hat ein eigenes Fenster und übernimmt FLAG_SECURE vom Fenster darunter
         // erst bei seinem nächsten Neuaufbau. Darum beide sofort, und beide gezählt.
-        val fenster = listOfNotNull(activity?.window, (view.parent as? DialogWindowProvider)?.window).distinct()
+        val fenster = listOfNotNull(activity?.window)
         fenster.forEach(::secure)
         onDispose { fenster.forEach(::giveFree) }
     }
