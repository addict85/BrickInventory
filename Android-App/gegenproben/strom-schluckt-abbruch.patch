Modul: core-services
Test: ch.brickinventoryapp.services.CsvStreamAbortTest
Rot: folgeStrom passes the cancellation on, a network error means fallback level

diff --git a/Android-App/core-services/src/main/java/ch/brickinventoryapp/services/service/CsvStrom.kt b/Android-App/core-services/src/main/java/ch/brickinventoryapp/services/service/CsvStrom.kt
--- a/Android-App/core-services/src/main/java/ch/brickinventoryapp/services/service/CsvStrom.kt
+++ b/Android-App/core-services/src/main/java/ch/brickinventoryapp/services/service/CsvStrom.kt
@@ -16,13 +16,13 @@
     weiter: (CsvImportStatusView) -> Boolean,
 ): Boolean {
     var gescheitert = false
-    fangeAusserAbbruch {
+    try {
         strom.takeWhile { ev ->
             when (ev) {
                 is CsvImportSseClient.Event.Status -> weiter(ev.status)
