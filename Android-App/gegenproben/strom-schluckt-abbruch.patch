Gegenprobe: folgeStrom fängt wieder jede Exception und schluckt so das Abbrechen
Modul: core-dienste
Test: ch.brickinventoryapp.dienste.CsvStromAbbruchTest
Rot: folgeStrom reicht das Abbrechen weiter

diff --git a/Android-App/core-dienste/src/main/java/ch/brickinventoryapp/dienste/service/CsvStrom.kt b/Android-App/core-dienste/src/main/java/ch/brickinventoryapp/dienste/service/CsvStrom.kt
--- a/Android-App/core-dienste/src/main/java/ch/brickinventoryapp/dienste/service/CsvStrom.kt
+++ b/Android-App/core-dienste/src/main/java/ch/brickinventoryapp/dienste/service/CsvStrom.kt
@@ -16,13 +16,13 @@ internal suspend fun folgeStrom(
     weiter: (CsvImportStatus) -> Boolean,
 ): Boolean {
     var gescheitert = false
-    fangeAusserAbbruch {
+    try {
         strom.takeWhile { ev ->
             when (ev) {
                 is CsvImportSseClient.Event.Status -> weiter(ev.status)
                 is CsvImportSseClient.Event.Failed -> { gescheitert = true; false }
             }
         }.collect { }
