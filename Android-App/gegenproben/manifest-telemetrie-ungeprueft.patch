Gegenprobe: Die Manifest-Prüfung übersieht ein datatransport-Backend (Telemetrie von ML Kit)
Modul: app
Test: ch.brickinventoryapp.app.ManifestPruefenTest
Rot: ein Telemetrie-Backend von ML Kit faellt auf

diff --git a/Android-App/tools/manifest-pruefen.py b/Android-App/tools/manifest-pruefen.py
--- a/Android-App/tools/manifest-pruefen.py
+++ b/Android-App/tools/manifest-pruefen.py
@@ -107,7 +107,7 @@
             continue
         for eintrag in alle(dienst, 'meta-data'):
             name = eintrag[1].get('name', '')
-            if name.startswith('backend:'):
+            if name.startswith('backend:') and False:
                 fehler.append(f'datatransport hat ein Backend ({name[8:]}): ML Kit sendet damit Nutzungsdaten '
                               f'an Google. Im App-Manifest mit tools:node="remove" herausnehmen.')
     return fehler
