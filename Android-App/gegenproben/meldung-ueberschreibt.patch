Gegenprobe: zeige() überschreibt die angezeigte Meldung wieder, statt einzureihen
Modul: core-data
Test: ch.brickinventoryapp.data.MeldungsWarteschlangeTest
Rot: die zweite Meldung wartet auf die Quittung der ersten

diff --git a/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/MeldungsKanal.kt b/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/MeldungsKanal.kt
--- a/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/MeldungsKanal.kt
+++ b/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/MeldungsKanal.kt
@@ -45,7 +45,7 @@ internal class MeldungsWarteschlange @Inject constructor() : MeldungsKanal {
         if (meldung == null) return
         synchronized(warteschlange) {
             when {
-                _meldung.value == null -> _meldung.value = meldung
+                _meldung.value == null || true -> _meldung.value = meldung
                 meldung == (warteschlange.lastOrNull() ?: _meldung.value) -> Unit
                 warteschlange.size < PLAETZE -> warteschlange.addLast(meldung)
             }
