Gegenprobe: Der Zertifikatsdialog sagt bei einer zu kurzen Abschrift wieder nur „passt nicht“
Modul: app
Test: ch.brickinventoryapp.app.CertificateDialogTest
Rot: too short and wrongly transcribed are different errors

diff --git a/Android-App/app/src/main/java/ch/brickinventoryapp/app/ui/components/CertificateDialog.kt b/Android-App/app/src/main/java/ch/brickinventoryapp/app/ui/components/CertificateDialog.kt
--- a/Android-App/app/src/main/java/ch/brickinventoryapp/app/ui/components/CertificateDialog.kt
+++ b/Android-App/app/src/main/java/ch/brickinventoryapp/app/ui/components/CertificateDialog.kt
@@ -175,8 +175,8 @@
 @Composable
 private fun transcriptError(finding: Transcript?, gezaehlt: Int): String? = when (finding) {
     null, Transcript.PASST -> null
-    Transcript.LEER, Transcript.TO_SHORT -> stringResource(R.string.zert_eingabe_zu_kurz, gezaehlt, Transcript.NEEDED)
-    Transcript.FITS_NOT -> stringResource(R.string.zert_eingabe_falsch)
+    Transcript.LEER -> stringResource(R.string.zert_eingabe_zu_kurz, gezaehlt, Transcript.NEEDED)
+    Transcript.TO_SHORT, Transcript.FITS_NOT -> stringResource(R.string.zert_eingabe_falsch)
 }
 
 /** Woher die Abschrift kommt: Schlüssel einer öffentlichen CA kennt die Webapp nicht, nur der Browser. */
