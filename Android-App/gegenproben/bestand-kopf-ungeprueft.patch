Gegenprobe: istKlartextDatenbank prüft den Dateikopf nicht mehr; jede Datei gälte als Klartext
Modul: core-offline
Test: ch.brickinventoryapp.offline.BestandSchluesselTest
Rot: die Datenbank bekommt einen fertigen Schluessel

diff --git a/Android-App/core-offline/src/main/java/ch/brickinventoryapp/offline/room/Bestandsverschluesselung.kt b/Android-App/core-offline/src/main/java/ch/brickinventoryapp/offline/room/Bestandsverschluesselung.kt
--- a/Android-App/core-offline/src/main/java/ch/brickinventoryapp/offline/room/Bestandsverschluesselung.kt
+++ b/Android-App/core-offline/src/main/java/ch/brickinventoryapp/offline/room/Bestandsverschluesselung.kt
@@ -86,7 +86,7 @@ internal fun istKlartextDatenbank(datei: File): Boolean {
     if (!datei.isFile || datei.length() < KOPF.size) return false
     val anfang = ByteArray(KOPF.size)
     datei.inputStream().use { if (it.read(anfang) != KOPF.size) return false }
-    return anfang.contentEquals(KOPF)
+    return true
 }

 private val KOPF = "SQLite format 3\u0000".toByteArray(Charsets.US_ASCII)
