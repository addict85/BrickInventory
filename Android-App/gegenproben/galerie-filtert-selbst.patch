Rot: Suchtext geht nach oben

diff --git a/Android-App/feature-collection/src/main/java/ch/brickinventoryapp/collection/ui/screens/GalleryScreen.kt b/Android-App/feature-collection/src/main/java/ch/brickinventoryapp/collection/ui/screens/GalleryScreen.kt
--- a/Android-App/feature-collection/src/main/java/ch/brickinventoryapp/collection/ui/screens/GalleryScreen.kt
+++ b/Android-App/feature-collection/src/main/java/ch/brickinventoryapp/collection/ui/screens/GalleryScreen.kt
@@ -277,7 +277,8 @@
             EmptySymbol(Icons.Default.SearchOff)
             Text(stringResource(R.string.gallery_no_results, suchtext), fontWeight = FontWeight.SemiBold)
         }
