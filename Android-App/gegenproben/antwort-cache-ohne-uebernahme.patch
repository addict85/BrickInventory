Gegenprobe: Der Antwort-Cache verwirft die Fassung 3 statt sie gebunden zu übernehmen (Datenverlust beim Update)
Modul: core-data
Test: ch.brickinventoryapp.AblageVerschluesselungTest
Rot: der Bestand ohne Bindung wird uebernommen

diff --git a/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/cache/ResponseCache.kt b/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/cache/ResponseCache.kt
index 950990d..ee44a42 100644
--- a/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/cache/ResponseCache.kt
+++ b/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/cache/ResponseCache.kt
@@ -72,7 +72,6 @@ class ResponseCache(
         val neu = File(ordnerQuelle(), "api-$VERSION").apply { mkdirs() }
         // Die Vorfassung (verschlüsselt, ohne Bindung) wird übernommen, nicht verworfen:
         // Offline wäre die App sonst nach dem Update leer.
-        runCatching { uebernimm(File(ordnerQuelle(), "api-${VERSION - 1}"), neu) }
         // Frühere Fassungen der Ablage (bis 2 im Klartext) gleich mit räumen, nicht nur übergehen.
         runCatching {
             ordnerQuelle().listFiles()?.filter { it.isDirectory && it.name.startsWith("api-") && it.name != "api-$VERSION" }
