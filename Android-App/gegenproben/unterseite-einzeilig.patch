Gegenprobe: Titel der Detail- und Unterseitenleiste wieder einzeilig
Modul: app
Test: ch.brickinventoryapp.app.AccessibilityTest
Rot: long titles wrap at 200 percent and are headings

diff --git a/Android-App/core-ui/src/main/java/ch/brickinventoryapp/ui/components/ListAndDetail.kt b/Android-App/core-ui/src/main/java/ch/brickinventoryapp/ui/components/ListAndDetail.kt
--- a/Android-App/core-ui/src/main/java/ch/brickinventoryapp/ui/components/ListAndDetail.kt
+++ b/Android-App/core-ui/src/main/java/ch/brickinventoryapp/ui/components/ListAndDetail.kt
@@ -115,7 +115,7 @@ fun DetailTopAppBar(
         title = {
             Column {
                 // Bei grosser Schrift drei Zeilen: Ein Teilename mit 30 Zeichen brauchte sie bei 200 %.
-                Text(titel, fontWeight = FontWeight.SemiBold, maxLines = if (largeFont()) 3 else 2, overflow = TextOverflow.Ellipsis,
+                Text(titel, fontWeight = FontWeight.SemiBold, maxLines = 1, overflow = TextOverflow.Ellipsis,
                     onTextLayout = { zeilen = it.lineCount }, modifier = Modifier.semantics { heading() })
                 if (subtitle != null) Text(subtitle, style = typo.bodySmall, maxLines = 1,
                     overflow = TextOverflow.Ellipsis)
