Gegenprobe: Offlineablage.bereich ruft die suspend-Quelle wieder in runCatching auf
Modul: app
Test: ch.brickinventoryapp.app.QuelltextRatscheTest
Rot: kein runCatching verschluckt

diff --git a/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/lokal/Offlineablage.kt b/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/lokal/Offlineablage.kt
--- a/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/lokal/Offlineablage.kt
+++ b/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/lokal/Offlineablage.kt
@@ -79,7 +79,7 @@ class Offlineablage(

     /** Der gültige Bereich, gestreut; null = nicht angemeldet, dann wird nichts abgelegt. */
     suspend fun bereich(): String? =
-        fangeAusserAbbruch { bereichQuelle() }.getOrNull()?.takeIf { it.isNotBlank() }.also { aktuell.value = it }
+        runCatching { bereichQuelle() }.getOrNull()?.takeIf { it.isNotBlank() }.also { aktuell.value = it }

     /** Wie viele Bearbeitungen noch auf den Server warten. */
