Modul: app
Test: ch.brickinventoryapp.app.DevicesProtectionTest
Rot: a new installation hides the preview until the user turns it off

diff --git a/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/DevicesStore.kt b/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/DevicesStore.kt
--- a/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/DevicesStore.kt
+++ b/Android-App/core-data/src/main/java/ch/brickinventoryapp/data/DevicesStore.kt
@@ -271,7 +271,7 @@ class DevicesStore @Inject constructor(
      * an: Die Übersicht zeigt Bestand, Preise und Konto jedem, der das Telefon kurz
      * in der Hand hat. Wer Bildschirmfotos braucht, schaltet es aus.
      */
-    override fun hidePreview(): Boolean = designMirror.getBoolean(PREVIEW_HIDE, true)
+    override fun hidePreview(): Boolean = designMirror.getBoolean(PREVIEW_HIDE, false)
     override fun setzeVorschauVerbergen(an: Boolean) {
         designMirror.edit { putBoolean(PREVIEW_HIDE, an) }
     }
