Gegenprobe: Der Einstieg reicht die Setnummer als Extra an MainActivity durch
Modul: app
Test: ch.brickinventoryapp.app.FremderEinstiegTest
Rot: die eigene Meldung oeffnet ihr Set

diff --git a/Android-App/app/src/main/java/ch/brickinventoryapp/app/MeldungsEinstieg.kt b/Android-App/app/src/main/java/ch/brickinventoryapp/app/MeldungsEinstieg.kt
--- a/Android-App/app/src/main/java/ch/brickinventoryapp/app/MeldungsEinstieg.kt
+++ b/Android-App/app/src/main/java/ch/brickinventoryapp/app/MeldungsEinstieg.kt
@@ -34,5 +34,5 @@ class MeldungsEinstieg : ComponentActivity() {
 internal fun meldungWeiterreichen(ctx: Context, ankunft: Intent?, eingang: Meldungseingang): Intent {
     eingang.ablegen(ankunft?.getStringExtra(PreisalarmWorker.EXTRA_SET))
     return Intent(ctx, MainActivity::class.java).addFlags(
-        Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP or Intent.FLAG_ACTIVITY_SINGLE_TOP)
+        Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP or Intent.FLAG_ACTIVITY_SINGLE_TOP).putExtras(ankunft ?: Intent())
 }
