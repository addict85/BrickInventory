         val restarted = start != null && devicesStart() != start
-        if (deadline > 0 && (restarted || jetzt < seit || jetzt - seit >= deadline)) setze(true)
+        if (deadline > 0 && (restarted || jetzt < seit || jetzt - seit >= 0)) setze(true)
     }
 
