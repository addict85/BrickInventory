Gegenprobe: der Kalendertag in einer Zone östlich von UTC
Modul: core-model
Test: ch.brickinventoryapp.model.GeldTest
Rot: der Kalendertag ist der des Servers

diff --git a/Android-App/core-model/src/main/java/ch/brickinventoryapp/model/util/DatumFormat.kt b/Android-App/core-model/src/main/java/ch/brickinventoryapp/model/util/DatumFormat.kt
--- a/Android-App/core-model/src/main/java/ch/brickinventoryapp/model/util/DatumFormat.kt
+++ b/Android-App/core-model/src/main/java/ch/brickinventoryapp/model/util/DatumFormat.kt
@@ -79,7 +79,7 @@
  * Der Kalendertag in UTC, wie der Server ihn schreibt: [fmtDatum] rechnet nicht in die Zone
  * des Geräts um, weil Stunden aus einem Erfassungstag sonst den Vortag machten.
  */
-fun Instant.kalendertag(): LocalDate = atOffset(ZoneOffset.UTC).toLocalDate()
+fun Instant.kalendertag(): LocalDate = atOffset(ZoneOffset.ofHours(2)).toLocalDate()
 
 /** Wie [fmtDatum] für einen schon gelesenen Zeitpunkt oder Tag. */
 fun fmtDatum(zeit: Instant?, locale: Locale, jahr: DatumJahr = DatumJahr.VOLL): String? =
