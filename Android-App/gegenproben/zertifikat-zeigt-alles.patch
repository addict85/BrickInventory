Gegenprobe: Der Zertifikatsdialog zeigt den ganzen Fingerabdruck, auch wo abgetippt wird
Modul: app
Test: ch.brickinventoryapp.app.CertificateDialogTest
Rot: wer abtippt

diff --git a/Android-App/app/src/main/java/ch/brickinventoryapp/app/ui/components/CertificateDialog.kt b/Android-App/app/src/main/java/ch/brickinventoryapp/app/ui/components/CertificateDialog.kt
--- a/Android-App/app/src/main/java/ch/brickinventoryapp/app/ui/components/CertificateDialog.kt
+++ b/Android-App/app/src/main/java/ch/brickinventoryapp/app/ui/components/CertificateDialog.kt
@@ -116,7 +116,7 @@
     // eines Angreifers ab statt aus der Webapp. Der Anfang zeigt nur, welche Zeile.
     Text(stringResource(if (writeOff) R.string.zert_beginnt_mit else R.string.zert_fingerabdruck),
         style = MaterialTheme.typography.labelMedium)
-    Text(if (writeOff) fingerprintStart(frage.fingerabdruck) else fingerprintReadable(frage.fingerabdruck),
+    Text(fingerprintReadable(frage.fingerabdruck),
         fontFamily = FontFamily.Monospace,
