Gegenprobe: „Erweitert“ ohne Zustand und ohne Auf-/Zuklappen für TalkBack
Modul: app
Test: ch.brickinventoryapp.app.AnmeldeRandTest
Rot: Erweitert meldet ob der Bereich offen ist

diff --git a/Android-App/feature-anmeldung/src/main/java/ch/brickinventoryapp/anmeldung/ui/screens/LoginScreen.kt b/Android-App/feature-anmeldung/src/main/java/ch/brickinventoryapp/anmeldung/ui/screens/LoginScreen.kt
--- a/Android-App/feature-anmeldung/src/main/java/ch/brickinventoryapp/anmeldung/ui/screens/LoginScreen.kt
+++ b/Android-App/feature-anmeldung/src/main/java/ch/brickinventoryapp/anmeldung/ui/screens/LoginScreen.kt
@@ -318,10 +318,7 @@ private fun AnmeldeFelder(
     var erweitert by rememberSaveable { mutableStateOf(vollerZugriff) }
     // Der Zustand für TalkBack: Ob der Bereich offen ist, sah man sonst nur.
     val zustand = stringResource(if (erweitert) R.string.zustand_ausgeklappt else R.string.zustand_eingeklappt)
-    TextButton(onClick = { erweitert = !erweitert }, modifier = Modifier.semantics {
-        stateDescription = zustand
-        if (erweitert) collapse { erweitert = false; true } else expand { erweitert = true; true }
-    }) {
+    TextButton(onClick = { erweitert = !erweitert }) {
         Text(stringResource(R.string.login_erweitert))
         Icon(if (erweitert) Icons.Default.ExpandLess else Icons.Default.ExpandMore, null)
     }
