Gegenprobe: „Erweitert“ ohne Zustand und ohne Auf-/Zuklappen für TalkBack
Modul: feature-login
Test: ch.brickinventoryapp.login.LoginEdgeTest
Rot: Advanced reports whether the area is open

diff --git a/Android-App/feature-login/src/main/java/ch/brickinventoryapp/login/ui/screens/LoginAnmelden.kt b/Android-App/feature-login/src/main/java/ch/brickinventoryapp/login/ui/screens/LoginAnmelden.kt
--- a/Android-App/feature-login/src/main/java/ch/brickinventoryapp/login/ui/screens/LoginAnmelden.kt
+++ b/Android-App/feature-login/src/main/java/ch/brickinventoryapp/login/ui/screens/LoginAnmelden.kt
@@ -106,10 +106,7 @@
     var extended by rememberSaveable { mutableStateOf(vollerZugriff) }
     // Der Zustand für TalkBack: Ob der Bereich offen ist, sah man sonst nur.
     val zustand = stringResource(if (extended) R.string.zustand_ausgeklappt else R.string.zustand_eingeklappt)
-    TextButton(onClick = { extended = !extended }, modifier = Modifier.semantics {
-        stateDescription = zustand
-        if (extended) collapse { extended = false; true } else expand { extended = true; true }
-    }) {
+    TextButton(onClick = { extended = !extended }) {
         Text(stringResource(R.string.login_erweitert))
         Icon(if (extended) Icons.Default.ExpandLess else Icons.Default.ExpandMore, null)
     }
