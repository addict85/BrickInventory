Gegenprobe: Der Bild-Client nimmt bei einer Umleitung auf demselben Host den Token ohne Blick auf den Basispfad mit (Stand vor sec8 N1)
Modul: core-network
Test: ch.brickinventoryapp.network.ImageHostGuardTest
Rot: Basispfad heraus

diff --git a/Android-App/core-network/src/main/java/ch/brickinventoryapp/network/util/BildHosts.kt b/Android-App/core-network/src/main/java/ch/brickinventoryapp/network/util/BildHosts.kt
--- a/Android-App/core-network/src/main/java/ch/brickinventoryapp/network/util/BildHosts.kt
+++ b/Android-App/core-network/src/main/java/ch/brickinventoryapp/network/util/BildHosts.kt
@@ -37,7 +37,7 @@ class ImageHostGuard(
             // Headers (the token included) move along only where the ServerWaechter would
             // also have sent them: same origin and under the base path. Otherwise a proxy
             // host is shared with a foreign application, and a redirect there would carry the token out.
-            val mitgenommen = if (ownServer(raus.url)) nextRedirect(raus, antwort, basePath()) else null
+            val mitgenommen = if (ownServer(raus.url)) nextRedirect(raus, antwort) else null
             antwort.close()
             anfrage = mitgenommen ?: Request.Builder().url(ziel).build()
         }
