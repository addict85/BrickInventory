Gegenprobe: Das Lesen des Tokens zählt auch bei gesperrtem Gerät jeden Versuch und gibt nach zehn Minuten auf
Modul: core-sicherheit
Test: ch.brickinventoryapp.sicherheit.VaultLockTest
Rot: bei gesperrtem Geraet wartet das Lesen

diff --git a/Android-App/core-sicherheit/src/main/java/ch/brickinventoryapp/sicherheit/Tresorbefund.kt b/Android-App/core-sicherheit/src/main/java/ch/brickinventoryapp/sicherheit/Tresorbefund.kt
--- a/Android-App/core-sicherheit/src/main/java/ch/brickinventoryapp/sicherheit/Tresorbefund.kt
+++ b/Android-App/core-sicherheit/src/main/java/ch/brickinventoryapp/sicherheit/Tresorbefund.kt
@@ -131,7 +131,7 @@
                 wait(VAULT_ATTEMPT_MS.getOrElse(attempt) { VAULT_FOLLOW_UP_MS })
                 // Bei gesperrtem Gerät gibt der Schlüssel erst nach dem Entsperren frei:
                 // Diese Zeit zählt nicht, sonst wäre nach einer Nacht die Sitzung weg.
-                if (attempt < VAULT_ATTEMPT_MS.size || !lock.gesperrt()) attempt++
+                attempt++
             }
         }
     }
