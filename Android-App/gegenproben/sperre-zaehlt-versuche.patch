Gegenprobe: Das Lesen des Tokens zählt auch bei gesperrtem Gerät jeden Versuch und gibt nach zehn Minuten auf
Modul: core-security
Test: ch.brickinventoryapp.security.VaultLockTest
Rot: with a locked device reading waits without a deadline and reports the token after unlocking

diff --git a/Android-App/core-security/src/main/java/ch/brickinventoryapp/security/Tresorbefund.kt b/Android-App/core-security/src/main/java/ch/brickinventoryapp/security/Tresorbefund.kt
--- a/Android-App/core-security/src/main/java/ch/brickinventoryapp/security/Tresorbefund.kt
+++ b/Android-App/core-security/src/main/java/ch/brickinventoryapp/security/Tresorbefund.kt
@@ -131,7 +131,7 @@
                 wait(VAULT_ATTEMPT_MS.getOrElse(attempt) { VAULT_FOLLOW_UP_MS })
                 // Bei gesperrtem Gerät gibt der Schlüssel erst nach dem Entsperren frei:
                 // Diese Zeit zählt nicht, sonst wäre nach einer Nacht die Sitzung weg.
-                if (attempt < VAULT_ATTEMPT_MS.size || !lock.gesperrt()) attempt++
+                attempt++
             }
         }
     }
