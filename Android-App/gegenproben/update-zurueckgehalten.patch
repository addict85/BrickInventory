Gegenprobe: Die App vergleicht die Beschreibung nicht mit dem schon gesehenen Stand (Stand vor sec10 N1)
Modul: core-update
Test: ch.brickinventoryapp.update.UpdateFreshTest
Rot: an older genuinely signed description reports a withholding

diff --git a/Android-App/core-update/src/main/java/ch/brickinventoryapp/update/util/UpdateFresh.kt b/Android-App/core-update/src/main/java/ch/brickinventoryapp/update/util/UpdateFresh.kt
--- a/Android-App/core-update/src/main/java/ch/brickinventoryapp/update/util/UpdateFresh.kt
+++ b/Android-App/core-update/src/main/java/ch/brickinventoryapp/update/util/UpdateFresh.kt
@@ -44,8 +44,6 @@ fun offerableVersion(b: UpdateBeschreibung, frische: UpdateFresh, laufend:
  */
 internal fun valueFresh(b: UpdateBeschreibung, gesehen: UpdateStatus?, laufend: Int, nowSec: Long): UpdateFresh = when {
     b.versionCode < laufend -> UpdateFresh.ZURUECKGESETZT
-    gesehen != null && (b.versionCode < gesehen.highestCode || b.ausgestellt < gesehen.ausgestellt) ->
-        UpdateFresh.ZURUECKGESETZT
     b.ausgestellt <= 0 || b.gueltigBis <= b.ausgestellt || b.gueltigBis <= nowSec -> UpdateFresh.ABGELAUFEN
     else -> UpdateFresh.AKTUELL
 }
