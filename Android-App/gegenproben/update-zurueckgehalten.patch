Gegenprobe: Die App vergleicht die Beschreibung nicht mit dem schon gesehenen Stand (Stand vor sec10 N1)
Modul: core-data
Test: ch.brickinventoryapp.UpdateFrischeTest
Rot: eine aeltere echt signierte Beschreibung meldet ein Zurueckhalten

diff --git a/Android-App/core-data/src/main/java/ch/brickinventoryapp/util/UpdateFrische.kt b/Android-App/core-data/src/main/java/ch/brickinventoryapp/util/UpdateFrische.kt
index ed233cc..3513069 100644
--- a/Android-App/core-data/src/main/java/ch/brickinventoryapp/util/UpdateFrische.kt
+++ b/Android-App/core-data/src/main/java/ch/brickinventoryapp/util/UpdateFrische.kt
@@ -32,8 +32,6 @@ fun quelleVeraltet(frische: UpdateFrische?): Boolean = frische != null && frisch
  */
 fun bewerteFrische(b: UpdateBeschreibung, gesehen: UpdateStand?, laufend: Int, jetztSek: Long): UpdateFrische = when {
     b.versionCode < laufend -> UpdateFrische.ZURUECKGESETZT
-    gesehen != null && (b.versionCode < gesehen.hoechsterCode || b.ausgestellt < gesehen.ausgestellt) ->
-        UpdateFrische.ZURUECKGESETZT
     b.ausgestellt <= 0 || b.gueltigBis <= b.ausgestellt || b.gueltigBis <= jetztSek -> UpdateFrische.ABGELAUFEN
     else -> UpdateFrische.AKTUELL
 }
