Gegenprobe: Das Set-Detail lädt bei jeder Änderung irgendeines Sets neu
Modul: feature-collection
Test: ch.brickinventoryapp.collection.SetDetailViewModelTest
Rot: ein geaenderter Kauf eines anderen Sets laedt hier nichts

diff --git a/Android-App/feature-collection/src/main/java/ch/brickinventoryapp/collection/ui/viewmodel/SetDetailViewModel.kt b/Android-App/feature-collection/src/main/java/ch/brickinventoryapp/collection/ui/viewmodel/SetDetailViewModel.kt
--- a/Android-App/feature-collection/src/main/java/ch/brickinventoryapp/collection/ui/viewmodel/SetDetailViewModel.kt
+++ b/Android-App/feature-collection/src/main/java/ch/brickinventoryapp/collection/ui/viewmodel/SetDetailViewModel.kt
@@ -104,7 +104,7 @@
         sequenceSignOut(sitzung) { reset() }
         // Ändert sich dieses Set in der Ablage — hier oder anderswo —, gelten Detail und Käufe nicht mehr.
         viewModelScope.launch {
-            sets.observeSets().map { l -> l.liste.firstOrNull { it.setNumber == setNumber } }
+            sets.observeSets().map { l -> l.liste }
                 .distinctUntilChanged().drop(1).collect {
                     if (_setDetailState.value.setDetail != null) { loadDetail(); loadPurchases() }
                 }
