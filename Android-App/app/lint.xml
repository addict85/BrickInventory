<?xml version="1.0" encoding="utf-8"?>
<!-- Keine Baseline: Hier stehen nur Befunde, die bewusst so gewollt sind, je mit Grund. -->
<lint>
    <!-- Schweizer Rechtschreibung (ss statt ß, die App rechnet in CHF): Ausgenommen sind
         nur Vorschläge mit ß wie „Vergrössern“ → „Vergrößern“; jeder andere Tippfehler
         im Deutschen bleibt ein Befund. Mit checkDependencies gilt das auch für core-ressourcen. -->
    <issue id="Typos">
        <ignore regexp="mean.*ß" />
    </issue>
    <!-- Postenart, Zustand und Scannerherkunft hält app/proguard-rules.pro: core-model ist
         reines Kotlin und kennt kein @Keep. -->
    <issue id="MissingKeepAnnotation">
        <ignore path="**/Postenart.class" />
        <ignore path="**/Zustand.class" />
        <ignore path="**/Scannerherkunft.class" />
    </issue>
</lint>
