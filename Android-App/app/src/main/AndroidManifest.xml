<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      enableOnBackInvokedCallback: Unter targetSdk 36 ist das der Standardwert,
      hier bewusst ausgeschrieben. Es ist der einzige Schalter aus dem Sprung
      von 35 auf 36, der das Verhalten sichtbar ändert (vorhersagendes
      Zurückwischen). Auf "false" setzen, falls die Animation stören sollte —
      die App hat keinen eigenen BackHandler, der davon abhinge.

      Bewusst NICHT gesetzt: screenOrientation und resizeableActivity. Unter
      targetSdk 36 würden sie auf grossen Displays ohnehin ignoriert.
    -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".BrickInventoryApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrickInventoryManager"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
          ML Kit wird UNBUNDLED benutzt (com.google.android.gms:
          play-services-mlkit-barcode-scanning): Das Erkennungsmodell liegt in
          den Google-Play-Diensten statt im APK. Damit verschwindet
          libbarhopper_v3.so aus der App — die einzige der nativen
          Bibliotheken, die sich nicht durch eine Aktualisierung ausrichten
          liess (siehe INVARIANTEN.md, "16-KB-Speicherseiten").

          Dieser meta-data-Eintrag lässt das Modul schon bei der Installation
          herunterladen. Ohne ihn würde es erst beim ersten Scan geladen — und
          der erste Scan wäre dann ohne Netz nicht möglich.
        -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode" />

        <service
            android:name=".service.CsvImportService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <service
            android:name=".service.PdfExportService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BrickInventoryManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
