<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      enableOnBackInvokedCallback: Unter targetSdk 36 ist das der Standardwert,
      hier bewusst ausgeschrieben. Es ist der einzige Schalter aus dem Sprung
      von 35 auf 36, der das Verhalten sichtbar ändert (vorhersagendes
      Zurückwischen). Auf "false" setzen, falls die Animation stören sollte —
      die App hat keinen eigenen BackHandler, der davon abhinge.

      Bewusst NICHT gesetzt: screenOrientation und resizeableActivity. Unter
      targetSdk 36 würden sie auf grossen Displays ohnehin ignoriert.
    -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Nur um zu ERKENNEN, ob das Geraet im WLAN, im Mobilfunknetz oder im
      Roaming haengt (data/Netzlage.kt). Das Vorwaermen der Vorschaubilder
      richtet sich danach; ohne diese Erlaubnis wuesste es nicht, wann es
      Datenvolumen kostet. Eine normale Erlaubnis — sie fragt niemanden.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      Ohne diese Zeile erklaert die CAMERA-Erlaubnis `android.hardware.camera`
      IMPLIZIT als erforderlich — und damit faellt die App auf Geraeten ohne
      Kamera aus dem Raster (ChromeOS-Geraete, manche Tablets). Lint meldet das
      als PermissionImpliesUnsupportedChromeOsHardware, Stufe ERROR — seit
      `abortOnError = true` (app/build.gradle.kts) bricht der Bau daran ab.

      `required="false"` ist hier nicht der Trick, mit dem man die Pruefung
      ruhigstellt, sondern die Wahrheit ueber die App: Bestand, Preise, Listen
      und Anleitungen brauchen keine Kamera. Das Scannen ist eine Funktion unter
      vielen.

      Was sich dadurch NICHT aendert: Die APK wird hier von Hand installiert
      (util/AppUpdate.kt holt sie aus dem GitHub-Release). Die Filterung nach
      `uses-feature` macht Play, nicht das Geraet — ein Geraet ohne Kamera
      konnte die App also auch vorher schon installieren. Diese Zeile berichtigt
      die ANGABE, sie oeffnet keinen neuen Weg.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Die App aktualisiert sich selbst aus dem GitHub-Release (util/AppUpdate.kt).
      Ab Android 8 — und minSdk ist 30, also auf JEDEM Geraet — genuegt diese
      Berechtigung allein nicht: Der Nutzer muss der App zusaetzlich einmal
      erlauben, Apps aus unbekannten Quellen zu installieren. Genau dorthin
      fuehrt der Knopf in den Einstellungen, wenn die Erlaubnis fehlt.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Nur um zu sehen, ob es eine Authenticator-App gibt (zweiter Faktor,
         EinstellungenKonto.kt); sonst bleibt der Schlüssel zum Kopieren. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="otpauth" />
        </intent>
        <!-- Den System-Installer sehen, um seinen Bestätigungsdialog zu prüfen
             (installerZiel, util/AppUpdate.kt). -->
        <intent>
            <action android:name="android.content.pm.action.CONFIRM_INSTALL" />
        </intent>
    </queries>

    <!--
      tools:targetApi="33" fuer localeConfig und enableOnBackInvokedCallback:
      Lint meldet beide als UnusedAttribute, weil sie erst ab API 33 wirken und
      minSdk 30 ist. Das ist KEIN Fehler, sondern die Absicht — auf aelteren
      Geraeten werden sie ignoriert, und die App funktioniert dort ohne sie.
      `tools:targetApi` ist die vorgesehene Form, das zu sagen; es legt keine
      Warnung still, sondern beantwortet sie.
    -->
    <application
        tools:targetApi="33"
        android:name=".BrickInventoryApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrickInventoryManager"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
          ML Kit wird UNBUNDLED benutzt (com.google.android.gms:
          play-services-mlkit-barcode-scanning): Das Erkennungsmodell liegt in
          den Google-Play-Diensten statt im APK. Damit verschwindet
          libbarhopper_v3.so aus der App — die einzige der nativen
          Bibliotheken, die sich nicht durch eine Aktualisierung ausrichten
          liess (siehe INVARIANTEN.md, "16-KB-Speicherseiten").

          Dieser meta-data-Eintrag lässt das Modul schon bei der Installation
          herunterladen. Ohne ihn würde es erst beim ersten Scan geladen — und
          der erste Scan wäre dann ohne Netz nicht möglich.
        -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode" />

        <service
            android:name=".service.CsvImportService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <service
            android:name=".service.PdfExportService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!--
          ── WorkManager NICHT beim Start hochfahren ───────────────────────────

          WorkManager meldet sich normalerweise ueber androidx.startup an. Das
          laeuft in einem ContentProvider, und ContentProvider laufen VOR
          Application.onCreate(). Scheitert dort etwas, stirbt die App, bevor
          eine einzige eigene Zeile gelaufen ist — kein runCatching der Welt
          kommt da noch hin, und auf dem Geraet steht nur "App wurde beendet".

          Der stuendliche Preisalarm ist eine ABSCHALTBARE Nebensache, in der
          Vorgabe sogar aus. Etwas, das die meisten Nutzer nie einschalten,
          gehoert nicht in den Pfad, den jeder Start durchlaufen muss.

          ── BESTAETIGT, nicht mehr vermutet ──────────────────────────────

          Als dieser Block entstand, war das eine Begruendung aus dem
          Lehrbuch: Ich konnte Marcos Absturz NICHT erklaeren und habe das
          auch so geschrieben. Geaendert wurde, was sich aendern liess.

          Marco, nach dem naechsten APK: „Ja die App startet wieder."

          Damit ist es keine Vorsichtsmassnahme mehr. Von den beiden
          Aenderungen jenes Commits konnte nur DIESE den Start betreffen —
          die andere (die Keep-Regel fuer den Worker) repariert etwas, das
          im Hintergrund laeuft und den Start nicht toeten kann. Der
          Initialisierer ist auf seinem Geraet also wirklich gescheitert.

          ── NACHTRAG 25.09.: Jetzt ist es bekannt ────────────────────────

          Hier stand: „WARUM er gescheitert ist, weiss bis heute niemand, und
          es wird sich auch nicht mehr herausfinden lassen." Das war falsch,
          und die Antwort kam von demselben Geraet.

          Nachdem der Preisalarm-Schalter seinen Fehler ANZEIGT statt die App
          mitzureissen, meldete er:

              androidx.work.impl.WorkDatabase_Impl.<init> []

          Eine NoSuchMethodException. WorkManager oeffnet beim Hochfahren seine
          Room-Datenbank, Room laedt die erzeugte Implementierung ueber ihren
          Namen und ruft getDeclaredConstructor() — und den hatte R8 im
          Release-Build entfernt. Der Start-Absturz und der Fehlschlag am
          Schalter waren DERSELBE Fehler an zwei Stellen.

          Die Keep-Regel steht jetzt in proguard-rules.pro, und
          tools/apk-pruefen.py liest im fertigen APK nach, ob der Konstruktor
          noch da ist.

          Der Ausbau hier bleibt trotzdem, und zwar aus dem Grund, der schon
          oben steht: Ein abschaltbarer stuendlicher Abruf, in der Vorgabe AUS,
          gehoert nicht in den Pfad, den jeder Start durchlaufen muss. Dass
          diese EINE Ursache behoben ist, macht den ContentProvider vor
          onCreate() nicht zu einem guten Ort.

          Stattdessen faehrt WorkManager beim ERSTEN Zugriff hoch (siehe
          Configuration.Provider in BrickInventoryApp). Der erste Zugriff ist
          PreisalarmWorker.einplanen(), und der steht in einem runCatching.
          Scheitert er jetzt, faellt der Alarm aus — die App startet.

          tools:node="remove" am meta-data nimmt genau diesen einen Eintrag
          aus dem zusammengefuehrten Manifest; der Provider selbst bleibt, denn
          emoji2, lifecycle und profileinstaller haengen ebenfalls daran.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
          taskAffinity="": Ohne Affinität kann keine fremde Activity, die sich die
          Affinität dieses Pakets gibt, in die Task der App rutschen oder beim
          Antippen des Symbols statt ihr erscheinen (Task-Hijacking). Gefunden wird
          die laufende App dann über ihre Klasse. Exportiert nur für den Launcher;
          sie liest keine Extras (MeldungsEinstieg). adjustResize: Erst damit meldet
          das System die Tastatur auch unter Android 10 als Inset (imePadding).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BrickInventoryManager.Start">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          Ziel der Preisalarm-Meldungen: nicht exportiert, damit nur die eigene
          PendingIntent ein Set öffnen kann. Ohne Oberfläche und ohne Eintrag in
          der Übersicht; er reicht an MainActivity weiter und schliesst sich.
        -->
        <activity
            android:name=".MeldungsEinstieg"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!--
          Startbildschirm-Widget (widget/SammlungsWidget.kt): Wert und G&V.
          Exportiert, weil der AppWidget-Dienst des Systems es anspricht;
          BIND_APPWIDGET hält nur das System, eine fremde App kann so weder
          Aktualisierung noch onEnabled/onDisabled auslösen.
        -->
        <receiver
            android:name=".widget.SammlungsWidgetEmpfaenger"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET"
            android:label="@string/widget_titel">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sammlungs_widget" />
        </receiver>

        <!-- Antwort der Installer-Sitzung des Selbst-Updates (util/AppUpdate.kt):
             nur über unsere PendingIntent erreichbar, darum nicht exportiert. -->
        <receiver
            android:name="ch.brickinventoryapp.util.InstallationsEmpfaenger"
            android:exported="false" />

        <!-- Die Teileliste liegt verschlüsselt; der Provider gibt sie nur aus dem Speicher
             weiter, und nur an die App, der die Auswahl das Leserecht gibt. -->
        <provider
            android:name="ch.brickinventoryapp.service.TeilelistenProvider"
            android:authorities="${applicationId}.teileliste"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
