<?xml version="1.0" encoding="utf-8"?>
<!--
  Kein Klartext, nirgends: Der Server läuft hinter Caddy mit https. Diese Datei
  ist die zweite Linie hinter dem Wächter (di/ServerWaechter.kt), der eine
  http-Anfrage schon vor dem Netz abbricht. Der Debug-Build hat eine eigene
  Fassung unter src/debug/ mit dem Emulator und dem Gerät selbst.

  Nur System-CAs. Nutzer-CAs und Pins des eigenen Servers entscheidet
  util/ServerVertrauen.kt zur Laufzeit.
-->
<network-security-config>
    <!--
      Die Selbstaktualisierung lädt ein APK von GitHub: nur System-CAs, auch wenn
      der Nutzer für seinen Server eigene CAs erlaubt. Die Signaturprüfung fängt
      ein fremdes APK ab, nicht aber ein unterdrücktes Update oder einen
      vorgetäuschten Downgrade. Zwei Hosts, weil der Anhang von
      *.githubusercontent.com ausgeliefert wird.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
