<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider-Freigabe: nur filesDir/pdf/, sonst nichts — nie cache-path oder
  files-path mit ".", dort lägen API-Cache (Inventar) und Bild-Cache offen. Dort
  liegt die Teileliste (PdfExportManager). Den externen App-Bereich braucht seit
  minSdk 30 niemand mehr. Das Update geht über eine PackageInstaller-Sitzung.
-->
<paths>
    <files-path name="pdf_internal" path="pdf/" />
</paths>
