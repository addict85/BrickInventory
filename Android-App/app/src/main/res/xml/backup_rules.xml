<?xml version="1.0" encoding="utf-8"?>
<!-- Für Android 11 und älter dieselben Ausnahmen wie data_extraction_rules.xml:
     Kontodaten verlassen das Gerät nicht, auch wenn allowBackup einmal anders stünde. -->
<full-backup-content>
    <exclude domain="file" path="datastore" />
    <exclude domain="database" path="bestand.db" />
    <exclude domain="sharedpref" path="widget.xml" />
    <exclude domain="sharedpref" path="design_spiegel.xml" />
    <exclude domain="file" path="vorschau" />
    <exclude domain="file" path="pdf" />
    <exclude domain="file" path="update" />
    <exclude domain="external" path="pdf" />
</full-backup-content>
