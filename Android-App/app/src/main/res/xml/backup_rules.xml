<?xml version="1.0" encoding="utf-8"?>
<!-- Für Android 11 und älter dieselben Ausnahmen wie data_extraction_rules.xml: ganze
     Domänen, auch wenn allowBackup einmal anders stünde. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
</full-backup-content>
